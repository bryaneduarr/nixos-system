@@ -0,0 +1,120 @@
+use super::*;
+
+fn state_with(configure: impl FnOnce(&mut ClientShellConfig)) -> ClientShellState {
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    configure(&mut config);
+    let mut state = ClientShellState::new(config);
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    state
+}
+
+fn toggle_tab_bar(state: &mut ClientShellState) -> ClientShellInput {
+    let mut outcome = ClientShellInput::default();
+    state.record_binding(
+        crate::input::KeybindMatch::Action(crate::input::KeybindAction::ToggleTabBar),
+        &mut outcome,
+    );
+    outcome
+}
+
+#[test]
+fn start_hidden_tab_bar_gives_its_row_to_the_pane_surface() {
+    let mut state = state_with(|config| config.tab_bar_start_hidden = true);
+    let layout = state.layout(106, 30);
+    assert!(layout.tab_bar.is_empty());
+    assert_eq!(layout.pane_surface.y, 0);
+    assert_eq!(layout.pane_surface.height, 30);
+    assert_eq!(state.surface_size(106, 30).rows, 30);
+    assert_eq!(
+        state.config.initial_surface_size(106, 30).rows,
+        state.surface_size(106, 30).rows
+    );
+    state.compose(106, 30).expect("hidden tab bar frame");
+    assert!(state.hits.tabs.is_empty());
+    assert!(state.hits.new_tab.is_empty());
+
+    let shown = toggle_tab_bar(&mut state);
+    assert!(shown.repaint);
+    assert!(shown.resize);
+    assert!(shown.actions.is_empty());
+    assert!(state.pane_surface.is_none());
+    state.set_pane_surface(surface());
+    let layout = state.layout(106, 30);
+    assert_eq!(layout.tab_bar.y, 0);
+    assert_eq!(layout.tab_bar.height, 1);
+    assert_eq!(layout.pane_surface.y, 1);
+    assert_eq!(state.surface_size(106, 30).rows, 29);
+    state.compose(106, 30).expect("shown tab bar frame");
+    assert!(!state.hits.tabs.is_empty());
+
+    toggle_tab_bar(&mut state);
+    assert!(state.layout(106, 30).tab_bar.is_empty());
+    state.set_pane_surface(surface());
+    state.compose(106, 30).expect("hidden again tab bar frame");
+    assert!(state.hits.tabs.is_empty());
+}
+
+#[test]
+fn default_config_keeps_the_tab_bar_and_toggle_hides_it() {
+    let mut state = state_with(|_| {});
+    assert_eq!(state.layout(106, 30).tab_bar.height, 1);
+    assert_eq!(state.config.initial_surface_size(106, 30).rows, 29);
+
+    toggle_tab_bar(&mut state);
+    assert!(state.layout(106, 30).tab_bar.is_empty());
+    assert_eq!(state.surface_size(106, 30).rows, 30);
+}
+
+#[test]
+fn bottom_tab_bar_hides_and_returns_to_the_last_row() {
+    let mut state = state_with(|config| {
+        config.tab_bar_position = crate::config::TabBarPositionConfig::Bottom;
+        config.tab_bar_start_hidden = true;
+    });
+    let layout = state.layout(106, 30);
+    assert!(layout.tab_bar.is_empty());
+    assert_eq!(layout.pane_surface.y, 0);
+    assert_eq!(layout.pane_surface.height, 30);
+
+    toggle_tab_bar(&mut state);
+    let layout = state.layout(106, 30);
+    assert_eq!(layout.tab_bar.y, 29);
+    assert_eq!(layout.tab_bar.height, 1);
+    assert_eq!(layout.pane_surface.y, 0);
+    assert_eq!(layout.pane_surface.height, 29);
+}
+
+#[test]
+fn manual_toggle_overrides_single_tab_auto_hide() {
+    let mut state = state_with(|config| config.hide_tab_bar_when_single_tab = true);
+    assert_eq!(state.focused_tab_count(), 1);
+    assert!(state.layout(106, 30).tab_bar.is_empty());
+
+    toggle_tab_bar(&mut state);
+    assert_eq!(state.layout(106, 30).tab_bar.height, 1);
+
+    toggle_tab_bar(&mut state);
+    assert!(state.layout(106, 30).tab_bar.is_empty());
+}
+
+#[test]
+fn config_reload_keeps_the_manual_tab_bar_choice() {
+    let mut state = state_with(|config| config.tab_bar_start_hidden = true);
+    toggle_tab_bar(&mut state);
+
+    let mut next = Config::default();
+    next.ui.tab_bar_start_hidden = true;
+    next.ui.hide_tab_bar_when_single_tab = true;
+    state.config.apply_live_config(&next, &[], &[]);
+
+    assert_eq!(state.layout(106, 30).tab_bar.height, 1);
+}
+
+#[test]
+fn mobile_layout_ignores_the_tab_bar_toggle() {
+    let mut state = state_with(|_| {});
+    let before = state.layout(44, 20);
+    toggle_tab_bar(&mut state);
+    assert_eq!(state.layout(44, 20), before);
+}
