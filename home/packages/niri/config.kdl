input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        natural-scroll
        dwt
        click-method "clickfinger"
        scroll-factor 0.7
    }

    focus-follows-mouse
}

output "DP-3" {
    mode "1920x1080@280"
    scale 1
    position x=0 y=0
    variable-refresh-rate on-demand=true
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

layout {
    gaps @windowGap@

    struts {
        left @outerStrut@
        right @outerStrut@
        top @outerStrut@
        bottom @outerStrut@
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        off
    }

    border {
        off
    }
}

blur {
    passes @blurPasses@
    offset @blurOffset@
    noise 0.0117
    saturation 1.0
}

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"

prefer-no-csd

window-rule {
    open-maximized-to-edges false
    geometry-corner-radius @rounding@
    clip-to-geometry true
}

window-rule {
    match app-id="^kitty$"

    background-effect {
        blur true
        xray false
    }
}

spawn-sh-at-startup "bash \"$HOME/.config/wallpapers/awww-matugen-init.sh\""

binds {
    Super+T { spawn "kitty"; }
    Super+Q { close-window; }
    Super+M { quit; }
    Super+V { toggle-window-floating; }
    Super+R { spawn "rofi" "-show" "drun"; }
    Super+B { spawn "zen-twilight"; }
    Super+P { switch-preset-column-width; }
    Super+F { maximize-column; }
    Super+Shift+F { fullscreen-window; }
    Super+O { toggle-overview; }

    Super+Left { focus-column-left; }
    Super+Right { focus-column-right; }
    Super+Up { focus-window-up; }
    Super+Down { focus-window-down; }
    Super+H { focus-column-left; }
    Super+L { focus-column-right; }
    Super+K { focus-window-up; }
    Super+J { focus-window-down; }

    Super+Shift+Left { move-column-left; }
    Super+Shift+Right { move-column-right; }
    Super+Shift+Up { move-window-up; }
    Super+Shift+Down { move-window-down; }

    Super+1 { focus-workspace "1"; }
    Super+2 { focus-workspace "2"; }
    Super+3 { focus-workspace "3"; }
    Super+4 { focus-workspace "4"; }
    Super+5 { focus-workspace "5"; }
    Super+Page_Up { focus-workspace-up; }
    Super+Page_Down { focus-workspace-down; }

    Super+Shift+1 { move-window-to-workspace "1"; }
    Super+Shift+2 { move-window-to-workspace "2"; }
    Super+Shift+3 { move-window-to-workspace "3"; }
    Super+Shift+4 { move-window-to-workspace "4"; }
    Super+Shift+5 { move-window-to-workspace "5"; }
    Super+Shift+Page_Up { move-window-to-workspace-up; }
    Super+Shift+Page_Down { move-window-to-workspace-down; }

    Super+Shift+W { spawn-sh "bash \"$HOME/.config/wallpapers/awww-wallpaper-switch.sh\""; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
}
