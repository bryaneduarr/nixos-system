# Nix build results and caches.
/result
/result-*
/.build-result

# Nix store temp files.
.nix-channels
.nix-defexpr
.nix-profile

# Editor temporary files.
*.swp
*~
*.bak

# OS-generated files.
.DS_Store
Thumbs.db

# Sensitive or local secrets.
secret.nix
local-config.nix

# Pi project runtime state; keep the declarative project settings tracked.
.pi/*
.pi/
!.pi/settings.json
.pi/tool-output/

# Pi harness working state (large command output, task reports, evidence).
.agent/

# Personal Claude Code settings.
.claude/settings.local.json

# Compiled Neovim spell additions; the .add word lists stay tracked.
nvim/spell/*.spl

# Local Pi dependencies for editor types and checks; Nix installs its own copy.
packages/pi/node_modules/

# Agent plans and briefs stay local; the pull request is the review.
.agents/plans/

# Worktrees that coding agents create for parallel work.
.claude/worktrees/

# Local TypeScript tool dependencies for editor types and checks; Nix installs its own copy.
scripts/rule-audit/node_modules/
scripts/agents/node_modules/
