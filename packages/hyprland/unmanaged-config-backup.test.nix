let
  flake = builtins.getFlake ("path:" + toString ../..);
  inherit (flake.inputs.nixpkgs) lib;
  pkgs = flake.inputs.nixpkgs.legacyPackages.${builtins.currentSystem};
  inherit
    (flake.nixosConfigurations.nixos.extendModules {
      modules = [ { custom.desktop-session.compositor = lib.mkForce "hyprland"; } ];
    })
    config
    ;
  home = config.home-manager.users.bryaneduarr;

  # The target system's coreutils cannot run here, so the local build replaces it.
  activation = builtins.unsafeDiscardStringContext home.home.activation.backupUnmanagedHyprlandConfig.data;
  targetCoreutils = lib.head (
    builtins.match ".*(/nix/store/[a-z0-9]{32}-coreutils-[^/]*)/bin/.*" activation
  );
  configLine = "hyprland_config=${lib.escapeShellArg "${home.xdg.configHome}/hypr/hyprland.conf"}";
  script =
    assert lib.hasInfix configLine activation;
    pkgs.writeText "backup-unmanaged-hyprland-config.sh" (
      builtins.replaceStrings
        [ configLine targetCoreutils ]
        [ ''hyprland_config="$config_under_test"'' "${pkgs.coreutils}" ]
        activation
    );

  check = pkgs.runCommand "unmanaged-hyprland-config-backup-check" { } ''
    set -euo pipefail
    shopt -s nullglob
    umask 022

    fail() {
      echo "$*" >&2
      exit 1
    }

    run() { "$@"; }

    backup() {
      local config_under_test="$1"
      source ${script}
    }

    new_config() {
      local directory="$TMPDIR/$1/config with spaces"
      mkdir -p "$directory"
      printf '%s\n' "$directory/hyprland.conf"
    }

    backups_of() {
      local backups=("$1".unmanaged.*)
      printf '%s\n' "''${#backups[@]}"
    }

    config=$(new_config stub)
    printf 'autogenerated = 1\nbind = SUPER, T, exec, kitty\n' > "$config"
    backup "$config"
    [[ $(backups_of "$config") == 1 ]] || fail "stub was not backed up once"
    cmp -s "$config" "$config".unmanaged.* || fail "stub backup differs"
    grep -q '^autogenerated = 1$' "$config" || fail "stub was modified"

    config=$(new_config custom)
    printf 'monitor = ,preferred,auto,1\n' > "$config"
    chmod 664 "$config"
    backup "$config"
    cmp -s "$config" "$config".unmanaged.* || fail "custom backup differs"
    [[ $(stat -c %a "$config".unmanaged.*) == 664 ]] || fail "custom backup mode changed"

    config=$(new_config symlink)
    printf 'monitor = ,preferred,auto,1\n' > "$(dirname "$config")/managed.conf"
    ln -s managed.conf "$config"
    backup "$config"
    [[ $(backups_of "$config") == 0 ]] || fail "symlink was backed up"
    [[ -L "$config" ]] || fail "symlink was replaced"

    config=$(new_config missing)
    backup "$config"
    [[ $(backups_of "$config") == 0 ]] || fail "missing config was backed up"
    [[ ! -e "$config" ]] || fail "missing config was created"

    config=$(new_config repeated)
    printf 'autogenerated = 1\n' > "$config"
    backup "$config"
    printf 'monitor = ,preferred,auto,1\n' > "$config"
    backup "$config"
    [[ $(backups_of "$config") == 2 ]] || fail "repeated backup overwrote an earlier one"
    [[ $(cat "$config".unmanaged.* | sort) == $'autogenerated = 1\nmonitor = ,preferred,auto,1' ]] ||
      fail "repeated backups lost content"

    config=$(new_config dry-run)
    printf 'autogenerated = 1\n' > "$config"
    (
      run() { printf '%s\n' "$*"; }
      backup "$config" > /dev/null
    )
    [[ $(backups_of "$config") == 0 ]] || fail "dry run wrote a backup"

    echo passed > "$out"
  '';
in
lib.trim (builtins.readFile "${check}")
